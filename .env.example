# ============================================
# RUBAIH GREEKS — Delta Options (production)
# ============================================
# NEVER commit .env. Copy to .env and fill values.
# Day-1: LIVE_TRADING=false, free capital ₹1000.

DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Delta Exchange API (India default base URL in config)
# https://www.india.delta.exchange/ → Settings → API
DELTA_API_KEY=
DELTA_API_SECRET=
# Optional override:
# DELTA_BASE_URL=https://api.india.delta.exchange

# MUST be "true" for real orders. Anything else = dry-run.
LIVE_TRADING=false

# Shared secret for mobile ↔ API
# Generate: openssl rand -hex 32
RUBAIH_GREEKS_API_TOKEN=

# One-time free-capital seed when wallet/ledger empty (INR equivalent budget)
RUBAIH_GREEKS_FREE_INR=1000

# Optional AI overlay — OpenRouter primary, NVIDIA fallback
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NVIDIA_TIMEOUT_SEC=60
